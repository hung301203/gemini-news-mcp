# Port Render sets automatically in production
PORT=8000

# Optional secret segment for the MCP endpoint:
# - Leave empty to serve at /mcp
# - Set a random string (e.g. openssl rand -hex 24) to serve at /mcp/<MCP_PATH_SECRET>
MCP_PATH_SECRET=

# In-memory TTL cache duration in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Per-IP rate limit in requests per minute (default: 60)
RATE_LIMIT_RPM=60

# Per-source HTTP fetch timeout in seconds (default: 7.0)
SOURCE_TIMEOUT_SECONDS=7.0
